{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A message in the chat screen",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "tool"]
        },
        "content": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["role", "content", "userId", "createdAt"]
    }
  },
  "firestore": {
    "messages": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Messages sent by users and assistants"
    }
  }
}
