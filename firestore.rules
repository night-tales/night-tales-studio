rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['role', 'content', 'createdAt'])
                    && request.resource.data.role in ['user', 'assistant', 'tool']
                    && request.resource.data.content is string
                    && request.resource.data.createdAt == request.time;
    }

    match /stories/{storyId} {
      allow read: if resource.data.isPublished == true
                  || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.content is string
                    && request.resource.data.genre is string
                    && request.resource.data.isPublished is bool;
      allow update: if request.auth != null
                    && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }
  }
}
