rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasAll(['role', 'content', 'createdAt'])
                    && request.resource.data.role in ['user', 'assistant', 'tool']
                    && request.resource.data.content is string
                    && request.resource.data.createdAt == request.time;
    }

    match /userKeys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /ai_tasks/{taskId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if false; // Assuming activities are generated by a backend or we don't have write UI
    }
  }
}
