rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /messages/{messageId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /userKeys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /ai_tasks/{taskId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    match /tasks/{taskId} {
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || (resource.data.sharedWithEmails != null && request.auth.token.email in resource.data.sharedWithEmails));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid; // Only owner can delete
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
