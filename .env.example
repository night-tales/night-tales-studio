# Public browser configuration
VITE_GOOGLE_MAPS_API_KEY=

# Server-only provider credentials. Never expose these as VITE_* variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AIML_API_KEY=

# Server configuration
ALLOWED_ORIGINS=http://localhost:3000

# Backend Firebase Admin (server-side only)
# Configure Application Default Credentials via GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL / Neon (backend)
JDBC_DATABASE_URL=jdbc:postgresql://host:5432/database?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10
